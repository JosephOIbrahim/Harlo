<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>

    <key>CFBundleDisplayName</key>
    <string>Harlo HealthBridge</string>

    <key>CFBundleExecutable</key>
    <string>HarloHealthBridge</string>

    <!-- App icon (AppIcon.icns ships in Resources/) -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>

    <key>CFBundleIdentifier</key>
    <string>com.harlo.healthbridge</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleName</key>
    <string>HarloHealthBridge</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>

    <key>CFBundleVersion</key>
    <string>1</string>

    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- Menu-bar-less, dock-less helper. Wakes on HKObserverQuery callbacks. -->
    <key>LSUIElement</key>
    <true/>

    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- HealthKit consent strings shown in the system permission dialog. -->
    <key>NSHealthShareUsageDescription</key>
    <string>HealthBridge reads heart rate, HRV, sleep, and activity from your Apple Watch (via your iPhone) and forwards trends to Harlo so it can notice when you are tired or stressed. Data stays on your Mac. You choose per data type.</string>

    <key>NSHealthUpdateUsageDescription</key>
    <string>HealthBridge does not write to Health. This permission is requested only so macOS can show a consistent consent dialog if a future feature needs it.</string>
</dict>
</plist>
