<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Socket-activated daemon for Harlo's CLI.

        Rule 1 (0W idle): no KeepAlive. launchd holds the listening
        socket node; the daemon process is spawned on first connect
        and adopts the listening fd via launch_activate_socket(3)
        with the Sockets key "HarloCommand". It serves connections
        until DAEMON_IDLE_TIMEOUT_S of idle, then exits 0. The node
        survives the exit — launchd owns it.

        Paths use '~' as a template marker; launchd never expands '~'.
        scripts/macos_install_daemon.py rewrites them — and
        ProgramArguments[0] when Harlo.app lives somewhere else (dev
        tree, custom prefix, homebrew cask, etc.) — at install time.
    -->
    <key>Label</key>
    <string>com.harlo.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Harlo.app/Contents/MacOS/Harlo</string>
        <string>--daemon</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HARLO_DATA_DIR</key>
        <string>~/Library/Application Support/Harlo</string>
    </dict>

    <key>Sockets</key>
    <dict>
        <key>HarloCommand</key>
        <dict>
            <key>SockPathName</key>
            <string>~/Library/Application Support/Harlo/twind.sock</string>
            <key>SockPathMode</key>
            <integer>384</integer> <!-- 0600 -->
        </dict>
    </dict>

    <key>StandardOutPath</key>
    <string>~/Library/Logs/Harlo/daemon.out.log</string>
    <key>StandardErrorPath</key>
    <string>~/Library/Logs/Harlo/daemon.err.log</string>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <!-- The SIGTERM path may legitimately spend up to DMN_BUDGET_S
         (30s) finishing synthesis (Rule S6); launchd's default
         SIGTERM-to-SIGKILL window (20s) would truncate the Rule-30
         dump. -->
    <key>ExitTimeOut</key>
    <integer>35</integer>
</dict>
</plist>
