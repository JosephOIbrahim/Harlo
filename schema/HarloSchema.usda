#usda 1.0
(
    """ Harlo codeless schema — Path C persistence layer.

        21 prim types representing the cognitive state hierarchy.
        Authored 2026-04-28 for Mile 2 Phase 2 of the codeless schema
        surgery. Substrate-unifies with sister project Moneta under a
        separate `harlo` plugin namespace; zero typeName collisions.

        IsA hierarchy: parallel-to-containment (D2).
            Typed (USD)
            └── HarloPrim                       (abstract)
                ├── HarloContainer              (abstract)
                │   └── 8 concrete containers
                └── 10 concrete typed leaves
            APISchemaBase (USD)
            └── Provenance                      (singleApply API schema, D10)

        Decisions applied (per harness/path_c/{05,06}_DECISIONS*.md):
            D5  InjectionPrim/InjectionContainerPrim NOT declared (evicted)
            D7  filename: HarloSchema.usda
            D8  CompositionLayerPrim.opinion → string sidecar (deferred)
            D9  IntakeHistoryPrim.answer_embeddings → string sidecar
            D10 Provenance is an apiSchema (singleApply), not a typedSchema
            D11 propertyOrder mandatory on every concrete class
            Cmd 11  arc_type allowedTokens: lower_case
    """
    subLayers = [
        @usd/schema.usda@
    ]
)

over "GLOBAL" (
    customData = {
        string libraryName = "harlo"
        string libraryPath = "./"
        bool skipCodeGeneration = true
    }
)
{
}

# =====================================================================
# Tier 1 — Abstract bases
# =====================================================================

class "HarloPrim" (
    inherits = </Typed>
    customData = {
        string className = "HarloPrim"
        string schemaKind = "abstractTyped"
    }
    doc = """Abstract root for every Harlo cognitive-state prim.

    Carries no attributes; exists for IsA-tier organization so consumers
    can enumerate Harlo-namespaced types via Plug.Registry queries
    distinct from Moneta or USD built-ins."""
)
{
}

class "HarloContainer" (
    inherits = </HarloPrim>
    customData = {
        string className = "HarloContainer"
        string schemaKind = "abstractTyped"
    }
    doc = """Abstract base for composite container prims.

    Containers hold child prims at fixed sub-paths but carry no scalar
    attributes themselves. Distinguishes structural composites from
    leaf prims at the schema-registry level."""
)
{
}

# =====================================================================
# Tier 2 — Concrete containers (alphabetical)
# =====================================================================

class AssociationPrim "AssociationPrim" (
    inherits = </HarloContainer>
    customData = {
        string className = "AssociationPrim"
        string schemaKind = "concreteTyped"
    }
    doc = """Container for memory traces (Association Engine, Hippocampus).

    Path: /Brain/Association
    Children: TracePrim instances at /Brain/Association/Traces/<trace_id>
    keyed by hex content hash."""
)
{
}

class BrainStage "BrainStage" (
    inherits = </HarloContainer>
    customData = {
        string className = "BrainStage"
        string schemaKind = "concreteTyped"
    }
    doc = """Root container for the entire cognitive state.

    Path: /Brain
    Children: 8 subsystem containers (AssociationPrim, CompositionPrim,
    ElenchusPrim, optional SessionPrim, InquiryContainerPrim,
    MotorContainerPrim, SkillsContainerPrim, CognitiveProfilePrim).
    InjectionContainerPrim is deliberately NOT declared per D5."""
)
{
}

class CognitiveProfilePrim "CognitiveProfilePrim" (
    inherits = </HarloContainer>
    customData = {
        string className = "CognitiveProfilePrim"
        string schemaKind = "concreteTyped"
    }
    doc = """Container for personal calibration data (intake-derived).

    Path: /Brain/CognitiveProfile
    Children: MultipliersPrim at .../Multipliers,
              IntakeHistoryPrim at .../IntakeHistory."""
)
{
}

class CompositionPrim "CompositionPrim" (
    inherits = </HarloContainer>
    customData = {
        string className = "CompositionPrim"
        string schemaKind = "concreteTyped"
    }
    doc = """Container for LIVRPS opinion layers (Composition Engine).

    Path: /Brain/Composition
    Children: CompositionLayerPrim instances at
    /Brain/Composition/Layers/<layer_id>."""
)
{
}

class ElenchusPrim "ElenchusPrim" (
    inherits = </HarloContainer>
    customData = {
        string className = "ElenchusPrim"
        string schemaKind = "concreteTyped"
    }
    doc = """Container for verification engine state (Elenchus GVR).

    Path: /Brain/Elenchus
    Children: optional GateStatusPrim at .../GateStatus,
              optional MerkleRootPrim at .../MerkleRoot."""
)
{
}

class InquiryContainerPrim "InquiryContainerPrim" (
    inherits = </HarloContainer>
    customData = {
        string className = "InquiryContainerPrim"
        string schemaKind = "concreteTyped"
    }
    doc = """Container for active DMN hypotheses (Inquiry Engine).

    Path: /Brain/Inquiry
    Children: ordered InquiryPrim instances at
    /Brain/Inquiry/hypothesis_<i>."""
)
{
}

class MotorContainerPrim "MotorContainerPrim" (
    inherits = </HarloContainer>
    customData = {
        string className = "MotorContainerPrim"
        string schemaKind = "concreteTyped"
    }
    doc = """Container for pending motor actions (Motor Cortex).

    Path: /Brain/Motor
    Children: ordered MotorPrim instances at /Brain/Motor/action_<i>."""
)
{
}

class SkillsContainerPrim "SkillsContainerPrim" (
    inherits = </HarloContainer>
    customData = {
        string className = "SkillsContainerPrim"
        string schemaKind = "concreteTyped"
    }
    doc = """Container for per-domain skill tracking.

    Path: /Brain/Skills
    Children: SkillPrim instances at /Brain/Skills/<domain>."""
)
{
}

# =====================================================================
# Tier 3 — Concrete typed leaves (alphabetical)
# =====================================================================

class CompositionLayerPrim "CompositionLayerPrim" (
    inherits = </HarloPrim>
    customData = {
        string className = "CompositionLayerPrim"
        string schemaKind = "concreteTyped"
    }
    doc = """A single LIVRPS opinion layer.

    Path: /Brain/Composition/Layers/<layer_id>
    May host an applied Provenance API schema (D10)."""
)
{
    token arc_type = "local" (
        allowedTokens = ["local", "inherit", "variant", "reference", "payload", "sublayer"]
        doc = "LIVRPS arc type. Lower-case per Cmd 11. Default: local (strongest)."
    )
    string opinion_json = "{}" (
        doc = "JSON-encoded opinion blob (string sidecar per D8). Free-form dict."
    )
    bool permanent = false (
        doc = "Permanent override flag (Amygdala reflex). Beats LIVRPS recency."
    )
    double timestamp (
        doc = "Authoring timestamp in Unix seconds (UTC)."
    )
}

class GateStatusPrim "GateStatusPrim" (
    inherits = </HarloPrim>
    customData = {
        string className = "GateStatusPrim"
        string schemaKind = "concreteTyped"
    }
    doc = """Elenchus verification gate state.

    Path: /Brain/Elenchus/GateStatus"""
)
{
    int cycle_count = 0 (
        doc = "GVR cycle count. Capped at 3 per Rule 13."
    )
    double last_verified (
        doc = "Last verification timestamp in Unix seconds (UTC)."
    )
    token verification_state = "pending" (
        allowedTokens = ["trusted", "contested", "refuted", "pending"]
        doc = "Current verification state. Default: pending."
    )
}

class InquiryPrim "InquiryPrim" (
    inherits = </HarloPrim>
    customData = {
        string className = "InquiryPrim"
        string schemaKind = "concreteTyped"
    }
    doc = """A single DMN hypothesis.

    Path: /Brain/Inquiry/hypothesis_<i>"""
)
{
    double confidence = 0.0 (
        doc = "Confidence in [0.0, 1.0]."
    )
    string hypothesis (
        doc = "Hypothesis text."
    )
}

class IntakeHistoryPrim "IntakeHistoryPrim" (
    inherits = </HarloPrim>
    customData = {
        string className = "IntakeHistoryPrim"
        string schemaKind = "concreteTyped"
    }
    doc = """Intake administration log.

    Path: /Brain/CognitiveProfile/IntakeHistory"""
)
{
    string answer_embeddings_json = "[]" (
        doc = "JSON-encoded float vector list (string sidecar per D9)."
    )
    string intake_version (
        doc = "Intake form version identifier. Optional."
    )
    double last_intake (
        doc = "Last intake timestamp in Unix seconds (UTC). Optional."
    )
}

class MerkleRootPrim "MerkleRootPrim" (
    inherits = </HarloPrim>
    customData = {
        string className = "MerkleRootPrim"
        string schemaKind = "concreteTyped"
    }
    doc = """Audit hash over /Brain/Association/Traces subtree.

    Path: /Brain/Elenchus/MerkleRoot"""
)
{
    string root_hash (
        doc = "Hex-encoded Merkle root hash."
    )
    int trace_count = 0 (
        doc = "Number of traces in the Association subtree at hash time."
    )
}

class MotorPrim "MotorPrim" (
    inherits = </HarloPrim>
    customData = {
        string className = "MotorPrim"
        string schemaKind = "concreteTyped"
    }
    doc = """A pending motor action with basal-ganglia gate status.

    Path: /Brain/Motor/action_<i>"""
)
{
    string action (
        doc = "Action descriptor."
    )
    token gate_status = "inhibited" (
        allowedTokens = ["inhibited", "approved", "executing"]
        doc = "Basal-ganglia gate status. Default: inhibited per Rule 23."
    )
}

class MultipliersPrim "MultipliersPrim" (
    inherits = </HarloPrim>
    customData = {
        string className = "MultipliersPrim"
        string schemaKind = "concreteTyped"
    }
    doc = """Personal calibration multipliers (intake-derived).

    Path: /Brain/CognitiveProfile/Multipliers"""
)
{
    double allostatic_threshold = 1.0 (
        doc = "Allostatic-load threshold for System 2 wake."
    )
    double detail_orientation = 0.5 (
        doc = "Detail-orientation calibration in [0.0, 1.0]."
    )
    double hebbian_alpha = 0.01 (
        doc = "Hebbian learning rate."
    )
    double reconstruction_threshold = 0.3 (
        doc = "Reconstruction quality threshold."
    )
    double surprise_threshold = 2.0 (
        doc = "Surprise threshold (z-score) for novelty detection."
    )
}

class SessionPrim "SessionPrim" (
    inherits = </HarloPrim>
    customData = {
        string className = "SessionPrim"
        string schemaKind = "concreteTyped"
    }
    doc = """Session metadata and dual-process routing state.

    Path: /Brain/Session (optional — absent if no active session)"""
)
{
    string current_session_id (
        doc = "Active session identifier."
    )
    int exchange_count = 0 (
        doc = "Number of exchanges in current session."
    )
    double last_query_surprise = 0.0 (
        doc = "Surprise score of last query."
    )
    token last_retrieval_path = "system_1" (
        allowedTokens = ["system_1", "system_2"]
        doc = "Dual-process retrieval path. Default: system_1."
    )
    double surprise_rolling_mean = 0.0 (
        doc = "Rolling mean of recent surprise scores."
    )
    double surprise_rolling_std = 0.0 (
        doc = "Rolling stddev of recent surprise scores."
    )
}

class SkillPrim "SkillPrim" (
    inherits = </HarloPrim>
    customData = {
        string className = "SkillPrim"
        string schemaKind = "concreteTyped"
    }
    doc = """Per-domain skill tracking.

    Path: /Brain/Skills/<domain>
    The prim's name (last path component) is the domain identifier."""
)
{
    double first_seen (
        doc = "First observation timestamp in Unix seconds (UTC)."
    )
    double[] growth_arc = [] (
        doc = "Per-observation growth scores."
    )
    double hebbian_density = 0.0 (
        doc = "Hebbian-density signal in [0.0, 1.0]."
    )
    double last_seen (
        doc = "Last observation timestamp in Unix seconds (UTC)."
    )
    int trace_count = 0 (
        doc = "Number of traces associated with this domain."
    )
}

class TracePrim "TracePrim" (
    inherits = </HarloPrim>
    customData = {
        string className = "TracePrim"
        string schemaKind = "concreteTyped"
    }
    doc = """A single memory trace in the Association Engine.

    Path: /Brain/Association/Traces/<trace_id>
    Codec-blockers per D8/D9: SDR fields are 512-char hex string
    sidecars; co_activations/competitions are JSON-string sidecars."""
)
{
    string co_activations_json = "{}" (
        doc = "JSON-encoded dict[trace_id, count] (string sidecar per D8)."
    )
    string competitions_json = "{}" (
        doc = "JSON-encoded dict[trace_id, count] (string sidecar per D8)."
    )
    string content_hash (
        doc = "Opaque content hash (16-char hex)."
    )
    string hebbian_strengthen_mask_hex (
        doc = "512-char hex sidecar for 2048-bit boolean mask (D8)."
    )
    string hebbian_weaken_mask_hex (
        doc = "512-char hex sidecar for 2048-bit boolean mask (D8)."
    )
    double last_accessed (
        doc = "Last access timestamp in Unix seconds (UTC)."
    )
    string sdr_hex (
        doc = "512-char hex sidecar for 2048-bit boolean SDR (D8)."
    )
    double strength = 0.0 (
        doc = "Lazy-decay strength: initial * e^(-lambda*dt) + sum(boosts)."
    )
}

# =====================================================================
# Applied API schema — Provenance (D10)
# =====================================================================

class "Provenance" (
    inherits = </APISchemaBase>
    customData = {
        string className = "Provenance"
        string schemaKind = "singleApplyAPI"
        token apiSchemaType = "singleApply"
    }
    doc = """Source/origin metadata as a singleApply API schema.

    Applied to host prims (typically CompositionLayerPrim) that need
    origin tracking. Per D10, modeled as an applied schema rather than
    a standalone typed prim so future Step 4 ComfyCozy work can attach
    provenance to its prims without schema changes."""
)
{
    string event_hash (
        doc = "Opaque hash of the originating event."
    )
    double origin_timestamp (
        doc = "Origin timestamp in Unix seconds (UTC)."
    )
    string session_id (
        doc = "Session identifier (string FK to SessionPrim.current_session_id)."
    )
    token source_type (
        allowedTokens = ["user_direct", "external_reference", "system_inferred", "hebbian_derived", "intake_calibrated"]
        doc = "Provenance source classification."
    )
}
